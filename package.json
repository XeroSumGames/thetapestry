{
  "name": "tapestry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "e2e:auth": "node e2e/capture-auth.mjs",
    "arch:check": "node scripts/check-arch.mjs",
    "arch:save": "node scripts/check-arch.mjs --save",
    "arch:depcruise": "depcruise lib components app --config .dependency-cruiser.cjs --output-type err",
    "check:publication": "node scripts/check-publication-drift.mjs",
    "check:db-emdashes": "node scripts/check-db-emdashes.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/nextjs": "^10.68.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@types/leaflet.markercluster": "^1.5.6",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet-control-geocoder": "^3.3.1",
    "leaflet.markercluster": "^1.5.3",
    "next": "^16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-virtuoso": "^4.18.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.6",
    "dependency-cruiser": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
